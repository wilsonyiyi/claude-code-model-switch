{
  "name": "@wilson_janet/claude-code-model-switch",
  "version": "1.6.0",
  "type": "module",
  "description": "A CLI tool to manage Claude Code model switching with multiple configurations",
  "main": "./dist/index.js",
  "bin": {
    "cm": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "tsc --watch",
    "test": "bash test.sh",
